# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Data snapshots / backups
*.bak.rds
# Data bundle: build artifact, gzip-compressed ~108MB (over GitHub's 100MB limit).
# Built by build_app_data.R; shipped to shinyapps.io via rsconnect, not via git.
shiny_app/app_data.rds

# RStudio project files
*.Rproj

# OS / shell junk
*.stackdump
.DS_Store

# rsconnect deploy logs (the .dcf deployment record IS tracked)
rsconnect/*.log
shiny_app/rsconnect/**/*.log

# Python model (model/) — build artefacts, not sources
__pycache__/
*.py[cod]
model/.venv/
.pytest_cache/

# generated report (rebuild: python3 tools/build_report_page.py)
model/report.html

# generated lab-meeting decks (rebuild: python3 model/tools/build_deck.py,
# Rscript shiny_app/build_deck.R) — both are build artifacts, never committed
model/deck.html
model/deck.pdf
shiny_app/deck.html
shiny_app/deck.pdf
shiny_app/deck.body.html

# generated deliverables: Excel workbooks + figures for collaborator requests
# (rebuild: analysis/<date>_<name>/run.sh) — large and fully regenerable
deliverables/
